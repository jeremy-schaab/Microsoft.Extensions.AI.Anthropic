# Azure Anthropic Foundry Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env files to version control!

# Required: Your Azure Anthropic Foundry resource name
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name

# Optional: API Key (if not using Azure Identity)
# If not set, the example will use Azure Identity (DefaultAzureCredential)
# Production environments should use Azure Identity instead of API keys
ANTHROPIC_FOUNDRY_API_KEY=your-api-key-here

# Optional: Bearer Token (advanced scenarios only)
# ANTHROPIC_FOUNDRY_BEARER_TOKEN=your-bearer-token

# ========================================
# Usage Instructions
# ========================================
#
# 1. Copy this file:
#    Windows: copy .env.example .env
#    Linux/Mac: cp .env.example .env
#
# 2. Edit .env and replace placeholder values with your actual credentials
#
# 3. Load environment variables:
#    Windows Command Prompt:
#      for /f "delims=" %i in (.env) do set %i
#
#    Windows PowerShell:
#      Get-Content .env | ForEach-Object { $_.Split('=')[0]; $_.Split('=')[1] } | Set-Item env:
#
#    Linux/Mac (Bash/Zsh):
#      export $(cat .env | xargs)
#
# 4. Run the example:
#    dotnet run
#
# ========================================
# Security Best Practices
# ========================================
#
# - NEVER commit .env files to version control
# - Use Azure Key Vault for production secrets
# - Prefer Azure Identity (Managed Identity) over API keys
# - Rotate API keys every 90 days if used
# - Use separate credentials for dev/test/production environments
